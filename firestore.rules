rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isLifetimeOwner() {
      return signedIn() && request.auth.token.email == 'daviris0508@gmail.com';
    }

    function hasActiveAccess(userId) {
      let data = get(/databases/$(database)/documents/users/$(userId)).data;
      return isOwner(userId)
        && data.acesso != null
        && data.acesso.status == 'ativo'
        && (
          (data.acesso.tipo == 'vitalicio' && isLifetimeOwner())
          ||
          (data.acesso.tipo == 'mensal'
            && data.acesso.vencimento != null
            && data.acesso.vencimento > request.time)
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      // O próprio usuário só pode criar seu perfil durante o onboarding.
      // A autorização vitalícia inicial é permitida exclusivamente ao proprietário.
      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.setupComplete == true
        && request.resource.data.profileMode in ['individual', 'juntos']
        && request.resource.data.acesso.tipo == 'vitalicio'
        && request.resource.data.acesso.status == 'ativo'
        && request.resource.data.acesso.vencimento == null
        && isLifetimeOwner();

      // Campos de assinatura/acesso não podem ser alterados pelo cliente.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'setupComplete', 'profileMode', 'updatedAt'
        ]);

      allow delete: if false;

      match /pessoas/{personId} {
        allow read, write: if hasActiveAccess(userId);
      }

      match /finance/{pessoaId} {
        allow read, write: if hasActiveAccess(userId)
          && (pessoaId == 'davi' || pessoaId == 'gabriel');
      }

      match /config/{configId} {
        allow read, write: if hasActiveAccess(userId)
          && configId == 'geral';
      }

      match /historico/{ano} {
        allow read, write: if hasActiveAccess(userId)
          && ano.matches('^[0-9]{4}$');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
